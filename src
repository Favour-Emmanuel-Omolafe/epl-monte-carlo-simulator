import numpy as np
from scipy.stats import poisson

def calculate_match_lambda(home_attack, away_defense, league_home_mean):
    """
    Computes expected home goals (lambda).
    """
    return home_attack * away_defense * league_home_mean

def calculate_match_mu(away_attack, home_defense, league_away_mean):
    """
    Computes expected away goals (mu).
    """
    return away_attack * home_defense * league_away_mean

def simulate_match(home_team, away_team, ratings, league_means):
    """
    Simulates a single 90-minute fixture using discrete Poisson draws.
    """
    lam = calculate_match_lambda(
        ratings[home_team]['attack'], 
        ratings[away_team]['defense'], 
        league_means['home']
    )
    mu = calculate_match_mu(
        ratings[away_team]['attack'], 
        ratings[home_team]['defense'], 
        league_means['away']
    )
    
    home_goals = poisson.rvs(lam)
    away_goals = poisson.rvs(mu)
    
    return home_goals, away_goals
